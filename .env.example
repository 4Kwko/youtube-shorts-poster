# Copie para .env e ajuste. NUNCA versione o .env.

# --- Aplicação ---
APP_NAME=clipper-api
APP_VERSION=0.1.0
# development | test | production
ENVIRONMENT=development
DEBUG=false

# --- API ---
API_PREFIX=/api/v1
# Origens permitidas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost

# --- Logging ---
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# json | text  (use "text" no dia a dia, "json" em produção)
LOG_FORMAT=text

# --- Mídia (FFmpeg/FFprobe) ---
# Timeout em segundos das chamadas ao ffprobe.
FFPROBE_TIMEOUT_SECONDS=30

# --- Ingestão de vídeo ---
# Duração máxima aceita (padrão: 3 horas).
MAX_VIDEO_DURATION_SECONDS=10800
# Tamanho máximo do arquivo baixado, em bytes (padrão: 2 GiB).
MAX_VIDEO_FILE_SIZE_BYTES=2147483648
# Altura máxima solicitada ao provedor. Acima disso o download é limitado, não recusado.
MAX_VIDEO_HEIGHT=1080
# Relógio de parede do download inteiro (padrão: 30 minutos).
DOWNLOAD_TIMEOUT_SECONDS=1800
# Timeout de socket individual e número de tentativas do yt-dlp.
DOWNLOAD_SOCKET_TIMEOUT_SECONDS=30
DOWNLOAD_RETRIES=3

# --- Clipping ---
# Duração de cada clip no modo fixo.
DEFAULT_CLIP_DURATION_SECONDS=90
CLIP_TIMEOUT_SECONDS=600

# --- Transcrição (faster-whisper) ---
# Defaults para CPU local; nada de GPU fixa. O modelo é baixado na primeira
# transcrição, não no start da aplicação.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5

# --- Legendas ---
# Blocos curtos: short-form pede leitura rápida.
SUBTITLE_MAX_WORDS=5
SUBTITLE_MAX_CHARS=32
SUBTITLE_MIN_DURATION_SECONDS=0.6
SUBTITLE_MAX_DURATION_SECONDS=2.5
SUBTITLE_PAUSE_BREAK_SECONDS=0.35

# --- Renderização vertical ---
# Resolução do output publicável (9:16).
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
RENDER_TIMEOUT_SECONDS=900

# --- Worker ---
# Espera do worker local entre varreduras do banco quando a fila está vazia.
WORKER_POLL_SECONDS=2

# --- Storage ---
# Raiz dos arquivos de mídia. Relativo ao diretório onde o servidor é iniciado.
STORAGE_ROOT=storage

# --- Banco de dados ---
# SQLAlchemy/Alembic leem esta variável. Caminho relativo à raiz do repo.
DATABASE_URL=sqlite:///./storage/app.db
