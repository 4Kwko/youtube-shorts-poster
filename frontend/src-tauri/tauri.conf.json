{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipper",
  "version": "0.1.0",
  "identifier": "com.clipper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clipper",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "media-src": "'self' http://127.0.0.1:8000 http://localhost:8000",
        "connect-src": "'self' http://127.0.0.1:8000 http://localhost:8000"
      },
      "devCsp": {
        "default-src": "'self'",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "media-src": "'self' http://127.0.0.1:8000 http://localhost:8000",
        "connect-src": "'self' ws://localhost:1420 http://localhost:1420 http://127.0.0.1:8000 http://localhost:8000"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
